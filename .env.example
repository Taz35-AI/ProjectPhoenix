# ---------------------------------------------------------------------------
# Project Phoenix environment. Copy to `.env.local` and fill in.
# NEVER commit real keys. Only NEXT_PUBLIC_* values reach the browser.
# ---------------------------------------------------------------------------

# --- Supabase (server-only secrets) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Supabase (safe for the client) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- AI (provider-independent; nothing here names a specific vendor) ---
# AI_PROVIDER: "mock" (default, zero-cost, no key) or "openai-compatible".
# The openai-compatible provider works with Qwen, OpenAI, Groq, OpenRouter,
# Together, Fireworks, Mistral, etc. — just point BASE_URL/MODEL at your host.
AI_PROVIDER=mock

# Example for a hosted Qwen endpoint (OpenAI-compatible):
#   AI_PROVIDER=openai-compatible
#   AI_BASE_URL=https://your-provider.example/v1
#   AI_MODEL=qwen3-32b
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=mock-1

AI_TIMEOUT_MS=30000
AI_MAX_INPUT_TOKENS=6000
AI_MAX_OUTPUT_TOKENS=700
AI_TEMPERATURE=0.6
